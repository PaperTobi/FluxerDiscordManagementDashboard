# Server settings, edited by hand too
schema = 1

[settings]
# be strict here
threshold = 0.4
strikes = 2

[settings.labels.harassment]
enabled = true

[[settings.escalation]]
action = "none"
duration = "5m"
from = 1
notify_owner = false

[[settings.escalation]]
action = "timeout"
duration = "10m"
from = 4
notify_owner = false

[people.5]
tracked = true
added_by = "1"
added_at = "1970-01-01T00:00:00Z"

[people.5.settings]
threshold = 0.7

[voice_lines.greeting]
text = { de = "Hallo {name}!" }
